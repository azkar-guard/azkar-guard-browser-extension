{
  "manifest_version": 3,
  "name": "Azkar Guard",
  "version": "0.1.0",
  "description": "Keeps reminding you until your morning and evening Azkar are complete.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Azkar Guard",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab/index.html"
  },
  "options_page": "src/options/index.html",
  "permissions": ["storage", "alarms", "notifications", "geolocation", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
